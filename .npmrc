# ============================================================
# SoulMap AI — pnpm / npm 配置
# ============================================================

# 国内镜像（如需官方源，改为 https://registry.npmjs.org）
registry=https://registry.npmmirror.com

# 严格依赖隔离，禁止幽灵依赖（架构文档 ADR-002）
shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true

# 允许的构建脚本（pnpm 10 默认阻止 postinstall，安全考虑）
# 仅放行已知必需的原生模块
enable-pre-post-scripts=true

# 提升常用开发工具到根 node_modules，便于编辑器与 CLI 直接调用
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=@types/*

# 锁文件与解析行为
resolution-mode=highest
save-exact=false

# 本地 store 落在工作区内，避免依赖用户级全局目录（便于沙箱/CI 隔离）
store-dir=D:/Projects/mbit/.pnpm-store
