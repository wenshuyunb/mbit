# ==============================================================================
# SoulMap AI — 环境变量权威模板
# ------------------------------------------------------------------------------
# 使用方式：
#   cp .env.example .env        然后填写真实值
#   ⚠ .env 已在 .gitignore 中，绝不可提交到版本库
#   ⚠ 生产环境的密钥必须通过 Docker secrets / 服务器环境变量注入，不得落在镜像里
#
# 生成密钥示例（PowerShell）：
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 应用基础
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=SoulMap AI
PORT=3000
# 全局 API 前缀（含版本号）
API_PREFIX=api/v1
# 日志级别：fatal|error|warn|info|debug|trace
LOG_LEVEL=debug
# 时区（容器与日志统一）
TZ=Asia/Shanghai
# 是否启用 Swagger 文档（生产环境建议 false 或加内网访问限制）
SWAGGER_ENABLED=true
# 是否启用 Prometheus 指标端点
METRICS_ENABLED=true
# 协议正文基址（隐私政策/用户协议/年龄声明/AI 内容提示/营销授权）
# 用户同意记录接口会据此拼接 url；未配置时该字段返回 null，前端隐藏「查看原文」入口
LEGAL_BASE_URL=https://www.soulmap.example.com/legal

# ------------------------------------------------------------------------------
# 2. 数据库 PostgreSQL 16
# ------------------------------------------------------------------------------
POSTGRES_USER=soulmap
POSTGRES_PASSWORD=soulmap_dev_pwd
POSTGRES_DB=soulmap
POSTGRES_PORT=5432
# 本地开发连接串（容器内互访时 host 用 postgres）
DATABASE_URL=postgresql://soulmap:soulmap_dev_pwd@127.0.0.1:5432/soulmap?schema=public
# 生产环境必须启用 SSL：在 URL 后追加 &sslmode=require
# 连接池
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT=20

# ------------------------------------------------------------------------------
# 3. Redis 7（缓存 / BullMQ 队列 / 限流 / 会话）
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=sm
# 队列
QUEUE_PREFIX=soulmap
QUEUE_CONCURRENCY_AI=5
QUEUE_CONCURRENCY_DEFAULT=10

# ------------------------------------------------------------------------------
# 4. JWT 与加密（⚠ 生产必须替换为强随机值，长度 ≥ 32）
# ------------------------------------------------------------------------------
# 用户端 realm
JWT_SECRET=CHANGE_ME_dev_only_user_access_secret_at_least_32_chars
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=30d
# 管理端 realm（必须与用户端不同）
ADMIN_JWT_SECRET=CHANGE_ME_dev_only_admin_access_secret_at_least_32_chars
ADMIN_JWT_ACCESS_TTL=1h
ADMIN_JWT_REFRESH_TTL=7d
# AES-256-GCM 主密钥（32 字节 base64，用于 session_key / 手机号等字段加密）
CRYPTO_KEY=Q0hBTkdFX01FXzMyX2J5dGVfYmFzZTY0X2tleV9kZXYhIQ==
# 一次性密码 / 邀请码签名盐
CRYPTO_IV_SALT=CHANGE_ME_dev_only_iv_salt

# ------------------------------------------------------------------------------
# 5. 微信小程序
# ------------------------------------------------------------------------------
WECHAT_APPID=wx0000000000000000
WECHAT_SECRET=CHANGE_ME_wechat_app_secret
# 内容安全检测开关（上线前必须开启；开发环境可关闭以便联调）
WECHAT_MSG_SEC_CHECK=false
# 订阅消息模板 ID（用户私聊/报告完成通知）
WECHAT_TMPL_REPORT_READY=
WECHAT_TMPL_INVITE_ACCEPTED=
WECHAT_TMPL_MEMBERSHIP_EXPIRING=

# ------------------------------------------------------------------------------
# 6. 微信支付 v3（JSAPI）
# ------------------------------------------------------------------------------
WECHAT_PAY_ENV=sandbox
WECHAT_PAY_MCHID=
WECHAT_PAY_SERIAL_NO=
# 商户私钥（PEM 内容，换行用 \n 转义；生产建议用文件挂载 + 路径引用）
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
# APIv3 密钥（32 位）
WECHAT_PAY_APIV3_KEY=
# 支付结果通知地址（必须公网 HTTPS，不能带参数）
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/v1/payments/wechat/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://api.example.com/api/v1/payments/wechat/refund-notify
# 平台证书序列号（用于回调验签）
WECHAT_PAY_PLATFORM_CERT_PATH=./certs/wechatpay_platform_cert.pem

# ------------------------------------------------------------------------------
# 7. LLM Provider（AI 能力）
# ------------------------------------------------------------------------------
# 默认 Provider：deepseek | openai | qwen
AI_DEFAULT_PROVIDER=deepseek
AI_MAX_RETRIES=2
AI_TIMEOUT_MS=60000
AI_STREAM_FIRST_TOKEN_TIMEOUT_MS=20000
AI_STREAM_TOTAL_TIMEOUT_MS=180000
# 全站每日成本预算（分）。超预算触发告警并可自动降级
AI_DAILY_COST_BUDGET_CENTS=50000
# 熔断：连续失败次数与熔断持续时间（毫秒）
AI_CIRCUIT_BREAKER_THRESHOLD=5
AI_CIRCUIT_BREAKER_COOLDOWN_MS=60000

# DeepSeek（境内首选）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# OpenAI（可选；⚠ 数据出境合规需评估，生产默认关闭）
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# 通义千问
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_DEFAULT_MODEL=qwen-plus

# ------------------------------------------------------------------------------
# 8. 阿里云 OSS（头像 / PDF 报告 / 分享图）
# ------------------------------------------------------------------------------
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=soulmap-dev
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 上传用 STS 角色（推荐，避免下发长期密钥）
OSS_STS_ROLE_ARN=
OSS_CDN_DOMAIN=
# 签名 URL 默认有效期（秒）
OSS_SIGNED_URL_TTL=900
# 上传大小上限（字节，默认 10MB）
OSS_MAX_UPLOAD_BYTES=10485760

# ------------------------------------------------------------------------------
# 9. 限流阈值（可按环境调整，不写死在代码里）
# ------------------------------------------------------------------------------
THROTTLE_GLOBAL_TTL=60
THROTTLE_GLOBAL_LIMIT=100
THROTTLE_AI_TTL=60
THROTTLE_AI_LIMIT=10
THROTTLE_LOGIN_TTL=300
THROTTLE_LOGIN_LIMIT=10

# ------------------------------------------------------------------------------
# 10. 业务开关与配额（灰度与运营配置）
# ------------------------------------------------------------------------------
FEATURE_COUPLE_MATCH=true
FEATURE_PAYMENT=true
FEATURE_AI_CHAT=true
# 免费用户 AI 对话总次数
QUOTA_FREE_AI_MESSAGES=5
# 会员每日 AI 对话次数
QUOTA_MEMBER_DAILY_AI_MESSAGES=100
# 报告免费预览比例（0-1）
REPORT_FREE_PREVIEW_RATIO=0.2
# 报告生成超时（毫秒）
REPORT_GENERATION_TIMEOUT_MS=180000
# 订单未支付自动关闭时长（分钟）
ORDER_EXPIRE_MINUTES=30
# 账号注销冷静期（天）
ACCOUNT_DELETION_GRACE_DAYS=7

# ------------------------------------------------------------------------------
# 11. 可观测性
# ------------------------------------------------------------------------------
SENTRY_DSN=
PROMETHEUS_PATH=/metrics
# 告警 Webhook（企业微信机器人）
ALERT_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 12. 前端（Admin 由 Vite 注入；小程序不使用 .env 而用 config/env.ts）
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:3000/api/v1
VITE_APP_TITLE=SoulMap AI 管理后台
