# 接口基础地址：开发环境使用相对路径，由 vite.config.ts 的 /api 代理转发到 127.0.0.1:3000
VITE_API_BASE_URL=/api/v1

# 浏览器标题与登录页标题
VITE_APP_TITLE=SoulMap AI 管理后台
