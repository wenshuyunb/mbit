# ============================================================
# 生产环境变量（SoulMap AI Web 管理后台）
# 生产由 Nginx 将 /api/* 反向代理到 backend:3000（架构 §17.1），
# 前端保持同源相对路径，避免跨域与 Cookie/凭证配置问题。
# ============================================================

# 接口基础地址（相对路径，由 Nginx 反向代理）
VITE_API_BASE_URL=/api/v1

# 浏览器标题
VITE_APP_TITLE=SoulMap AI 管理后台
